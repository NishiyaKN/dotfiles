#############################
### ENVIRONMENT VARIABLES ###
#############################
env = CLUTTER_BACKEND,wayland
env = GDK_BACKEND,wayland,x11
env = QT_AUTO_SCREEN_SCALE_FACTOR,1
env = QT_QPA_PLATFORM,wayland
env = QT_QPA_PLATFORMTHEME,qt6ct   
env = QT_SCALE_FACTOR,1
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = HYPRCURSOR_THEME,rose-pine-hyprcursor
env = HYPRCURSOR_SIZE,32
env = GTK_THEME,gtk
env = OPENSSL_CONF,/dev/null

env = WAYLAND_DISPLAY,wayland-0
env = LIBGL_ALWAYS_INDIRECT,1

# Memory usage optimizations for ROCm
env = PYTORCH_ALLOC_CONF,expandable_segments:True
env = TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL,1

# Ollama options
env = OLLAMA_CONTEXT_LENGTH,16384
env = OLLAMA_FLASH_ATTENTION,1
env = OLLAMA_KV_CACHE_TYPE,q8_0

# Firefox Wayland
env = MOZ_ENABLE_WAYLAND,1

# Electron >28 apps
env = ELECTRON_OZONE_PLATFORM_HINT,auto

################
### MONITORS ###
################

monitor = DP-2, 2560x1440@180.00Hz, 0x0, 1
monitor = HDMI-A-2, 1920x1080@100.00Hz, 2560x0, 1

workspace = 1, monitor:DP-2
workspace = 2, monitor:DP-2
workspace = 3, monitor:DP-2
workspace = 4, monitor:DP-2
workspace = 5, monitor:DP-2
workspace = 6, monitor:HDMI-A-2
workspace = 7, monitor:HDMI-A-2
workspace = 8, monitor:HDMI-A-2
workspace = 9, monitor:HDMI-A-2
workspace = 10, monitor:HDMI-A-2

# Unscale XWayland
xwayland {
  force_zero_scaling = true
}

#################
### AUTOSTART ###
#################
exec-once = swaybg -o DP-2 -m fill -i /home/yori/.config/hypr/wallpapers/Monochrome.png
exec-once = swaybg -o HDMI-A-2 -m fill -i /home/yori/.config/hypr/wallpapers/Monochrome.png
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = /home/yori/re/git/dotfiles/scripts/notmine/killportal.sh
exec-once = dunst
exec-once = hyprctl setcursor Dracula-cursors 24
exec-once = blueman-applet
exec-once = nm-applet --indicator
exec-once = qbittorrent
exec-once = systemctl --user start hyprpolkitagent
exec-once = fcitx5
exec-once = kdeconnectd
exec-once = kdeconnect-indicator
exec-once = mpd
exec-once = waybar
exec-once = swaync
exec-once = nohup easyeffects --gapplication-service

# Clipboard manager
exec-once = wl-paste --type text --watch cliphist store 
exec-once = wl-paste --type image --watch cliphist store

# Rainbow borders & Pyprland
$UserScripts = $HOME/.config/hypr/UserScripts
exec-once = $UserScripts/RainbowBorders.sh &
exec-once = pypr &

################
### KEYBINDS ###
################
$mainMod = SUPER

bind = SUPER, V, exec, cliphist list | rofi -dmenu -display-columns 2 | cliphist decode | wl-copy
bind = $mainMod SHIFT, K, exec, hyprctl kill
bind = $mainMod, RETURN, exec, alacritty
bind = $mainMod SHIFT, W, killactive, 
bind = $mainMod CTRL, M, exit, 
bind = $mainMod, M, exit, 
bind = $mainMod, E, exec, dolphin
bind = $mainMod, S, togglefloating, 
bind = $mainMod, F, fullscreen, 
bind = $mainMod, space, exec, rofi -show drun 
bind = $mainMod SHIFT, S, exec, ~/.cargo/bin/wayfreeze --after-freeze-cmd 'FILE="$HOME/Pictures/sc/$(date +%Y%m%d-%H%M%S).png" && grim -g "$(slurp)" "$FILE" && wl-copy < "$FILE"; pkill -x wayfreeze'

# Layout keybinds
bind = $mainMod, T, pseudo,
bind = $mainMod, J, layoutmsg, togglesplit

# Focus movement
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

bind = SUPER, h, movefocus, l
bind = SUPER, l, movefocus, r
bind = SUPER, k, movefocus, u
bind = SUPER, j, movefocus, d

# Workspaces
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Move window to workspace
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Mouse workspace switching
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Move/resize windows
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

bind = SUPERSHIFT, left, movewindow, l
bind = SUPERSHIFT, right, movewindow, r
bind = SUPERSHIFT, up, movewindow, u
bind = SUPERSHIFT, down, movewindow, d

bind = SUPERSHIFT, h, movewindow, l
bind = SUPERSHIFT, l, movewindow, r
bind = SUPERSHIFT, k, movewindow, u
bind = SUPERSHIFT, j, movewindow, d

# MPD / MPC
binde = SUPERSHIFT, M, exec, pkill -9 mpd || mpd
bindl = SUPERSHIFT, PERIOD, exec, mpc toggle
bindl = SUPER, PERIOD, exec, mpc next
bindl = SUPER, COMMA, exec, mpc prev

# Display DPMS controls
bindl = SUPER, BackSpace, exec, hyprctl dispatch dpms on
bindl = SUPERSHIFT, BackSpace, exec, hyprctl dispatch dpms off

# Audio & Backlight keys
binde = , XF86AudioLowerVolume, exec, /opt/pulsemixer --change-volume -5 --unmute
binde = , XF86AudioRaiseVolume, exec, /opt/pulsemixer --change-volume +5 --unmute
binde = , XF86AudioMute, exec, pulsemixer --toggle-mute
binde = , XF86AudioMicMute, exec, amixer set Capture toggle

binde = , XF86MonBrightnessUp, exec, brightnessctl s +5%
binde = , XF86MonBrightnessDown, exec, brightnessctl s 5%-

# Pyprland zoom
bind = $mainMod, Z, exec, pypr zoom

################
### SETTINGS ###
################
source = $HOME/.config/hypr/wallust/wallust-hyprland.conf

dwindle {
  preserve_split = true
  special_scale_factor = 0.8
}

master {
  new_on_top = true
  mfact = 0.5
}

general {
  allow_tearing = true
  border_size = 2
  gaps_in = 6
  gaps_out = 8
  resize_on_border = true
  
  col.active_border = $color12 
  col.inactive_border = $background

  layout = dwindle
}

decoration {
  rounding = 10
  active_opacity = 1.0
  fullscreen_opacity = 1.0

  dim_strength = 0.1
  dim_special = 0.8

  blur {
      enabled = true    
      size = 6
      passes = 2
      ignore_opacity = false
      new_optimizations = true
      special = true
  }
}

animations {
  enabled = true

  bezier = wind, 0.05, 0.9, 0.1, 1.05
  bezier = winIn, 0.1, 1.1, 0.1, 1.1
  bezier = winOut, 0.3, -0.3, 0, 1
  bezier = liner, 1, 1, 1, 1
  
  animation = windows, 1, 6, wind, slide
  animation = windowsIn, 1, 6, winIn, slide
  animation = windowsOut, 1, 5, winOut, slide
  animation = windowsMove, 1, 5, wind, slide
  animation = border, 1, 1, liner
  animation = borderangle, 1, 180, liner, loop
  animation = fade, 1, 10, default
  animation = workspaces, 1, 5, wind
}

input {
  kb_layout = us
  repeat_rate = 50
  repeat_delay = 300
  numlock_by_default = true
  left_handed = false
  follow_mouse = 1
  float_switch_override_focus = 0
  scroll_factor = 0.5
  sensitivity = 0

  touchpad {
      scroll_factor = 0.5
      natural_scroll = true
  }
}

device {
    name = bt5.1-keyboard-1503-keyboard
    scroll_factor = 0.5
    natural_scroll = true
    sensitivity = 2
}

gestures {
  workspace_swipe_distance = 500
  workspace_swipe_invert = true
  workspace_swipe_min_speed_to_force = 30
  workspace_swipe_cancel_ratio = 0.5
  workspace_swipe_create_new = true 
  workspace_swipe_forever = true
}

group {
  col.border_active = $color15

  groupbar {
      col.active = $color0
  }
}

misc {
  disable_hyprland_logo = true
  disable_splash_rendering = true
  mouse_move_enables_dpms = true
  key_press_enables_dpms = true
  enable_swallow = true
  swallow_regex = ^(kitty)$
  focus_on_activate = false
}

binds {
  workspace_back_and_forth = true
  allow_workspace_cycles = true
  pass_mouse_when_bound = false
}

cursor {
  no_hardware_cursors = false
  enable_hyprcursor = true
}

####################
### WINDOW RULES ###
####################

# Idle Inhibit Rules
windowrule = match:class .*, idle_inhibit fullscreen

# Immediate / Tearing Rules
windowrule = match:class .*, immediate 1

# Floating Rules
windowrule = match:class ^(org.kde.polkit-kde-authentication-agent-1)$, float 1
windowrule = match:class ^([Zz]oom|onedriver|onedriver-launcher)$, float 1
windowrule = match:title ^(File Operation Progress)$, float 1
windowrule = match:title ^(Confirm to replace files)$, float 1
windowrule = match:class ^(xdg-desktop-portal-gtk)$, float 1
windowrule = match:title ^(Calculator)$, float 1
windowrule = match:title ^(Add Folder to Workspace)$, float 1
windowrule = match:class ^([Rr]ofi)$, float 1
windowrule = match:class ^(eog)$, float 1
windowrule = match:class ^(pavucontrol|org.pulseaudio.pavucontrol)$, float 1
windowrule = match:class ^(nwg-look|qt5ct|qt6ct|mpv)$, float 1
windowrule = match:class ^(nm-applet|nm-connection-editor|blueman-manager)$, float 1
windowrule = match:class ^(gnome-system-monitor|org.gnome.SystemMonitor)$, float 1
windowrule = match:class ^(yad)$, float 1
windowrule = match:class ^(wihotspot-gui)$, float 1
windowrule = match:class ^(evince)$, float 1
windowrule = match:class ^(file-roller|org.gnome.FileRoller)$, float 1
windowrule = match:class ^([Bb]aobab|org.gnome.[Bb]aobab)$, float 1
windowrule = match:title ^(Kvantum Manager)$, float 1
windowrule = match:class ^([Qq]alculate-gtk)$, float 1
windowrule = match:class ^([Ww]hatsapp-for-linux)$, float 1
windowrule = match:class ^([Ff]erdium)$, float 1

# Opacity Rules
windowrule = match:class ^([Ww]ofi)$, opacity 0.7 0.6
windowrule = match:class ^(Alacritty)$, opacity 0.9 0.8
windowrule = match:class ^(kitty)$, opacity 0.9 0.8

# Window Sizing
windowrule = match:class ^(gnome-system-monitor|org.gnome.SystemMonitor)$, size 70% 70%
windowrule = match:class ^(xdg-desktop-portal-gtk)$, size 70% 70%
windowrule = match:title ^(Kvantum Manager)$, size 60% 70%
windowrule = match:class ^(qt6ct)$, size 60% 70%
windowrule = match:class ^(evince|wihotspot-gui)$, size 70% 70%
windowrule = match:class ^(file-roller|org.gnome.FileRoller)$, size 60% 70%

# Layer Rules
layerrule = blur on, match:namespace overview
layerrule = ignore_alpha 0, match:namespace overview

# Picture-in-Picture Rules
windowrule = match:title ^(Picture-in-Picture)$, opacity 0.95 0.75
windowrule = match:title ^(Picture-in-Picture)$, pin 1
windowrule = match:title ^(Picture-in-Picture)$, float 1
windowrule = match:title ^(Picture-in-Picture)$, size 25% 25%
windowrule = match:title ^(Picture-in-Picture)$, move 72% 7%

# Workspace Rules ("Smart Gaps")
workspace = w[t1], gapsout:0, gapsin:0
workspace = w[tg1], gapsout:0, gapsin:0
workspace = f[1], gapsout:0, gapsin:0

windowrule = match:float 0, match:workspace w[t1], border_size 0
windowrule = match:float 0, match:workspace w[t1], rounding 0
windowrule = match:float 0, match:workspace w[tg1], border_size 0
windowrule = match:float 0, match:workspace w[tg1], rounding 0
windowrule = match:float 0, match:workspace f[1], border_size 0
windowrule = match:float 0, match:workspace f[1], rounding 0
